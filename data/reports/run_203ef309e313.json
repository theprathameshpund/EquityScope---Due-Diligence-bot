          "operating_margin_fy2023",
          "operating_margin_fy2024",
          "operating_margin_fy2025",
          "operating_margin_trend_bps"
        ],
        "verification_status": "supported",
        "section": "financial_health"
      },
      {
        "claim_id": "clm_a3c2810add49",
        "text": "Net margins have been relatively stable, with values of 25.31%, 25.31%, 23.97%, and 26.92% for FY2022, FY2023, FY2024, and FY2025 respectively, and a significant year-over-year change of 294.4 basis points from FY2024 to FY2025.",
        "citation_chunk_ids": [],
        "metric_ids": [
          "net_margin_fy2022",
          "net_margin_fy2023",
          "net_margin_fy2024",
          "net_margin_fy2025",
          "net_margin_trend_bps"
        ],
        "verification_status": "supported",
        "section": "financial_health"
      },
      {
        "claim_id": "clm_536bf4f33baa",
        "text": "The company's leverage, as measured by its debt-to-EBITDA ratio of 0.63, and liquidity, as indicated by a current ratio of 0.89, which is below 1.0 and may indicate potential liquidity issues, are important considerations for its financial health.",
