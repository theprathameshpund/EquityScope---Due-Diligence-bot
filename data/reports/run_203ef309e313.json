      },
      {
        "claim_id": "clm_b600547731c8",
        "text": "The company has demonstrated moderate revenue growth, with a compound annual growth rate of 1.81% from FY2022 to FY2025 and a year-over-year growth rate of 6.43% from FY2024 to FY2025.",
        "citation_chunk_ids": [],
        "metric_ids": [
