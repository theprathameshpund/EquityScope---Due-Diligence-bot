        ],
        "verification_status": "supported",
        "section": "financial_health"
      },
      {
        "claim_id": "clm_68d745b45131",
        "text": "Gross margins have shown an increasing trend, with values of 43.31%, 44.13%, 46.21%, and 46.91% for FY2022, FY2023, FY2024, and FY2025 respectively, and a year-over-year change of 69.9 basis points from FY2024 to FY2025.",
        "citation_chunk_ids": [],
        "metric_ids": [
