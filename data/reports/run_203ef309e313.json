        ],
        "verification_status": "supported",
        "section": "financial_health"
      },
      {
        "claim_id": "clm_6de54719b87d",
        "text": "Operating margins have also shown a generally increasing trend, with values of 30.29%, 29.82%, 31.51%, and 31.97% for FY2022, FY2023, FY2024, and FY2025 respectively, and a year-over-year change of 46.1 basis points from FY2024 to FY2025.",
        "citation_chunk_ids": [],
