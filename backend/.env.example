# ---- LLM providers ----------------------------------------------------------------------------------------
GROQ_API_KEY=                       # required - primary Groq key
GROQ_API_KEY_2=                     # optional - fallback Groq key
GROQ_API_KEY_3=                     # optional - fallback Groq key
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=                  # optional -- writer/critic; leave empty to use Groq for everything
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_WRITER_PROVIDER=groq            # groq | anthropic -- routing for writer & critic agents
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_S=60
GROQ_MAX_RPM=28                     # proactive pacing: max requests/min to Groq (0 = off)
GROQ_TPM_FAST=6000                  # tokens/min budget, fast model (Groq free tier)
GROQ_TPM_SMART=12000                # tokens/min budget, smart model (Groq free tier)

# ---- Embeddings (local, no API needed) ----------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
PRELOAD_EMBEDDINGS=false

# ---- Vector DB ------------------------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=equityscope_filings
QDRANT_LOCAL_PATH=data/qdrant

# ---- Storage ----------------------------------------------------------------------------------------------------
RUNTIME_STORAGE=local               # local = no Redis/Postgres/Qdrant server; external = use URLs below
POSTGRES_DSN=postgresql://equityscope:equityscope@localhost:5432/equityscope
REDIS_URL=redis://localhost:6379/0

# ---- Data sources ------------------------------------------------------------------------------------------
EDGAR_USER_AGENT="Your Name your.email@example.com"   # required by SEC
FRED_API_KEY=                       # optional -- macro context section skipped if empty
NEWS_RSS_ENABLED=true               # Google News RSS, no key needed

# ---- Pipeline tuning ------------------------------------------------------------------------------------
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=12
RERANK_TOP_N=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CRITIC_NLI_MODEL=cross-encoder/nli-deberta-v3-base
CRITIC_MAX_REVISIONS=2
CRITIC_ENTAILMENT_THRESHOLD=0.7
RUN_TOKEN_BUDGET=150000             # hard cap per report run
FILINGS_LOOKBACK_8K_MONTHS=12
FILINGS_NUM_10Q=4

# ---- App ------------------------------------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501
LOG_LEVEL=INFO
ENVIRONMENT=development             # development | production

# ---- Observability (optional, all features work without it) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Cost table (USD per 1M tokens, input/output) ------------------------
COST_GROQ_FAST_IN=0.05
COST_GROQ_FAST_OUT=0.08
COST_GROQ_SMART_IN=0.59
COST_GROQ_SMART_OUT=0.79
COST_ANTHROPIC_IN=3.00
COST_ANTHROPIC_OUT=15.00
